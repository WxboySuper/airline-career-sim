{
  "name": "airline-career-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint packages apps",
    "test": "pnpm --filter @airline-career-sim/shared build && pnpm --filter @airline-career-sim/game-data build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^3.1.3"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.0"
    }
  }
}
